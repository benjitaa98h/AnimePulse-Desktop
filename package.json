{
  "name": "animepulse",
  "productName": "AnimePulse",
  "version": "2.0.8",
  "description": "AnimePulse - Tracker de anime para PC inspirado en Taiga con la estética de AniList/Netflix. Integra la API GraphQL de AniList (con respaldo de Jikan/MyAnimeList) y un Auto-Scrobbler real.",
  "main": "main.js",
  "author": "benjitaa98h",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.animepulse.desktop",
    "productName": "AnimePulse",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "discord-rpc.js",
      "folder-watcher.js",
      "src/db.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "benjitaa98h"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AnimePulse"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "benjitaa98h",
        "repo": "AnimePulse-Desktop"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3"
  }
}
