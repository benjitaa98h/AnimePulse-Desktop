{
  "name": "animepulse",
  "productName": "AnimePulse",
  "version": "2.0.4",
  "description": "AnimePulse - Tracker de anime para PC inspirado en Taiga con la estética de AniList/Netflix. Integra la API GraphQL de AniList (con respaldo de Jikan/MyAnimeList) y un Auto-Scrobbler real.",
  "main": "main.js",
  "author": "Otaku Tracker",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.animepulse.desktop",
    "productName": "AnimePulse",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "discord-rpc.js",
      "folder-watcher.js",
      "src/db.js",
      "src/scrobbler.js",
      "src/utils.js",
      "src/state.js",
      "src/api.js",
      "src/modules/scrobbler.js",
      "src/modules/calendar.js",
      "src/modules/stats.js",
      "src/modules/gamification.js",
      "src/modules/organizer.js",
      "src/modules/settings.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Otaku Tracker"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AnimePulse"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "benjitaa98h",
        "repo": "AnimePulse-Desktop"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
